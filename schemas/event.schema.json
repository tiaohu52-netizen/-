{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://longtask.dev/schemas/event.schema.json",
  "title": "LongTask Event",
  "description": "协议事件（DESIGN.md §13.3 事件表最小公共字段；专有 payload 在 schemas/events/ 逐一定义）",
  "type": "object",
  "required": [
    "event_id",
    "contract_id",
    "event_type",
    "payload_json",
    "request_id",
    "created_at",
    "actor",
    "schema_version"
  ],
  "properties": {
    "event_id": { "type": "integer", "minimum": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": ["string", "null"] },
    "lease_generation": { "type": ["integer", "null"], "minimum": 1 },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z-]+$",
      "description": "词汇表见 longtask.persistence.events.EventType；只增不改"
    },
    "payload_json": {
      "type": "string",
      "description": "JSON 编码的专有 payload；公共字段 actor/reason/evidence"
    },
    "request_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "actor": { "enum": ["user", "daemon", "adapter", "model"] },
    "schema_version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
